# Exclusions Docker — accélère le build et protège les fichiers sensibles

# Dépendances (réinstallées dans le container)
node_modules/

# Build (reconstruit dans le container)
dist/

# Git et CI
.git/
.gitignore
.github/
.gitlab-ci.yml
.agents/
.semgrep*

# Docs et fichiers temporaires
*.md
*.log
*.bak
*.local

# Tests
**/*.test.*
**/*.spec.*
coverage/

# Variables d'environnement locales — NE JAMAIS inclure dans Docker
.env
.env.*
!.env.example

# Configs plateformes tierces
.vercel/
.netlify/
fly.toml
vercel.json
netlify.toml

# Fichiers Docker eux-mêmes
Dockerfile
.dockerignore
npm-debug.log
