# Example environment variables for local development
# Copy this file to .env and fill the values before running the app

# Supabase (required for multiplayer). Leave empty for local in-memory fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Message shown in the UI when Supabase env vars are missing.
# You can customize this to your preferred language/message.
VITE_SUPABASE_UNAVAILABLE_MESSAGE=Multijoueur indisponible : variables Supabase manquantes en production. Vérifiez VITE_SUPABASE_URL et VITE_SUPABASE_ANON_KEY.

# Mux player iframe (optional)
#VITE_MUX_IFRAME_SRC=https://player.mux.com/01mywJGOo4l00f8YOasdq4nIXXI6vrrIIVTKtMN6PCeQM?autoplay=true&loop=true&muted=true&controls=false
# Supabase (requis en production)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx
# Pour le CI GitHub et les migrations Supabase :
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_xxx
# SUPABASE_ACCESS_TOKEN=xxx

# Monitoring (optionnel)
VITE_SENTRY_DSN=https://your@sentry.dsn/xxxx

# Déploiement (optionnel)
VITE_BASE_PATH=/

NODE_ENV=development
PORT=5173
